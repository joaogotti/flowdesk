# Real environment files; keep public templates at every level.
**/.env
**/.env.*
!**/.env.example

# Database backups, exports and local SQLite databases.
backups/
**/*.dump
**/*.sql
**/*.backup
**/*.dump.gz
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.sql.zst
**/*.backup.gz
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*

# Private keys, private certificate bundles and local credentials.
**/*.key
**/*.private.pem
**/*-key.pem
**/*_key.pem
**/private.pem
**/privkey*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/.ssh
**/.aws
**/auth.json
**/credentials.json
**/credentials.local.*
**/secrets.local.*
**/.netrc
**/_netrc
**/.pypirc
**/.npmrc.local

# Installed dependencies and generated builds.
**/node_modules
**/vendor
**/dist
**/dist-ssr
backend/public/build/
backend/public/hot
backend/public/storage

# Laravel runtime data and caches; retain directory scaffold markers.
backend/bootstrap/cache/**
backend/storage/**
!backend/bootstrap/cache/.gitignore
!backend/storage/**/.gitignore
**/.phpunit.cache
**/.phpunit.result.cache
**/.php-cs-fixer.cache
**/.eslintcache
**/.vite
**/*.tsbuildinfo

# Logs, temporary files and development leftovers.
**/logs
**/*.log
**/.tmp
**/.temp
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~
**/*.bak
**/*.orig
**/*.rej

# Local Git, editor and operating-system metadata.
**/.git
**/.vscode
**/.idea
**/.codex
**/.cursor
**/.DS_Store
**/Thumbs.db
